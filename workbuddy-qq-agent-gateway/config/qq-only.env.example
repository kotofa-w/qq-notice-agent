# Copy to config/qq-only.env (ignored by Git), or pass an existing private file.
# Node --env-file syntax; Windows paths use forward slashes and quotes.
CODEX_REMOTE_CONTACT_HOST=127.0.0.1
CODEX_REMOTE_CONTACT_PORT=3789
CODEX_REMOTE_CONTACT_DISABLE_AUTH=0
# REQUIRED: administrator and separate bot identities. No default accounts.
CODEX_REMOTE_CONTACT_OWNER_QQ_ID=
CODEX_REMOTE_CONTACT_BOT_QQ_ID=
CODEX_REMOTE_CONTACT_ENGINE=workbuddy
ONEBOT_API_BASE=http://127.0.0.1:3000

# Set these in the launching process, or in your private local env file.
# CODEX_REMOTE_CONTACT_API_TOKEN=
# ONEBOT_ACCESS_TOKEN=

# Use your independently installed and logged-in official CLI 2.161.4.
# See docs/WINDOWS.md. This is a Node script, not an executable.
WB_AGENT_CLI="C:/path/to/codebuddy-cli/node_modules/@tencent-ai/codebuddy-code/bin/codebuddy"
# Optional overrides; the module venv and the gateway's Node are used by default.
# CODEX_REMOTE_CONTACT_WB_PYTHON="C:/path/to/python.exe"
# WB_AGENT_NODE_DIR="C:/Program Files/nodejs"
# CODEX_REMOTE_CONTACT_GROUP_WORKSPACE_ROOT="D:/path/to/group-workspaces"
# CODEX_REMOTE_CONTACT_PERSONA_DIR=config/private/persona

# Container uploads/media adaptation are delivered in stage B.
# Use your existing container and actual Docker executable/context then.
# CODEX_REMOTE_CONTACT_DOCKER_PATH="C:/Program Files/Docker/Docker/resources/bin/docker.exe"
# CODEX_REMOTE_CONTACT_DOCKER_CONTEXT=desktop-linux
# CODEX_REMOTE_CONTACT_SNOWLUMA_CONTAINER=snowluma
CODEX_REMOTE_CONTACT_QQ_FILE_STAGING_ROOT=/tmp/codexremotecontact-qq-files
# local requires the OneBot bridge to share this Windows host and user-readable files.
CODEX_REMOTE_CONTACT_QQ_FILE_TRANSPORT=local
CODEX_REMOTE_CONTACT_QQ_AGENT_TIMEOUT_MS=600000
CODEX_REMOTE_CONTACT_AUTO_COMPACT_TOKEN_LIMIT=200000
CODEX_REMOTE_CONTACT_AUTO_COMPACT_TOKEN_SCOPE=total

# Optional CalDAV backend. Use the actual discovered writable calendar URL.
# CODEX_REMOTE_CONTACT_CALENDAR_PROVIDER=caldav
# CODEX_REMOTE_CONTACT_CALDAV_URL=https://dav.fruux.com/calendars/ACCOUNT/CALENDAR/
# CODEX_REMOTE_CONTACT_CALDAV_CALENDAR_NAME=Calendar
# CODEX_REMOTE_CONTACT_CALDAV_REMINDER_MINUTES=30
# Windows deployment runner imports a CurrentUser-encrypted PSCredential file.
# CODEX_REMOTE_CONTACT_CALDAV_CREDENTIAL_FILE=C:/path/to/credential.clixml
# Other launchers must inject CALDAV_USERNAME and CALDAV_PASSWORD in process env.
